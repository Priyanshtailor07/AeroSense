# Local environment template for AeroSense
# Copy this file to .env and fill in your local values.
#
# Everything here is compiled into the browser bundle, so it must contain only
# PUBLIC identifiers. None of these values is a secret.
#
# The Cognito app client secret is NEVER set here. It lives in AWS Secrets
# Manager and is read only by the auth Lambda (backend/auth-service), which
# computes SECRET_HASH server-side. If you find yourself wanting a
# VITE_COGNITO_CLIENT_SECRET variable, that is the bug this setup fixes.

# API Gateway base URL. Required, absolute, and with no trailing slash.
# A missing value is a hard error: the app will not fall back to relative paths.
VITE_AEROSENSE_API_URL=https://w13tvv9i82.execute-api.ap-south-1.amazonaws.com

VITE_AWS_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=ap-south-1_FKhf1Lwlb
VITE_COGNITO_CLIENT_ID=3k6ksdrbrlqppsd2kc5tqoaa1m

# Which Cognito token the API Gateway JWT authorizer accepts: "access" or "id".
# Optional, defaults to "access". If the authorizer disagrees, the API client
# detects it and retries with the other kind, so this is a hint, not a hard
# requirement.
VITE_COGNITO_TOKEN_TYPE=access
